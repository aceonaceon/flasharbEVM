# 複製成 .env 後填寫。.env 不會進 git。
# Cloudflare Tunnel 的 token（Zero Trust → Networks → Tunnels）
TUNNEL_TOKEN=
# 填好 TUNNEL_TOKEN 後，把下一行的 # 拿掉，網頁的 tunnel 才會啟動
# COMPOSE_PROFILES=tunnel
# 選填：更快的 RPC（例如 Alchemy 免費方案）。留空就用免費的公開 RPC。
FLASHARB_RPC_URL=
# 其他鏈側錄器的 RPC（留空 = 用設定檔裡的免費公開 RPC）
FLASHARB_BSC_RPC_URL=
FLASHARB_ETH_RPC_URL=
FLASHARB_BASE_RPC_URL=
FLASHARB_OP_RPC_URL=
FLASHARB_POLYGON_RPC_URL=
# 選填：要跑哪個分支編出來的映像檔（預設 main）
FLASHARB_TAG=main
